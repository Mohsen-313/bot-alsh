async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):

    query = update.callback_query

    await query.answer()

    user_id = query.from_user.id
    data = query.data

    # =====================================================
    # حماية لوحة الإدارة
    # =====================================================

    if data.startswith("admin_") or data.startswith("confirm_delete:") or data.startswith("delete_user:"):

        if not is_admin(user_id):

            await query.message.reply_text(
                "⛔ هذا القسم مخصص للإدارة فقط."
            )

            return

    # =====================================================
    # الرجوع إلى لوحة الإدارة
    # =====================================================

    if data == "admin_back":

        await query.message.reply_text(
            "👑 لوحة إدارة بوت الأسد\n\n"
            "اختر العملية التي تريد تنفيذها:",
            reply_markup=admin_menu()
        )

        return

    # =====================================================
    # قائمة المشتركين
    # =====================================================

    if data == "admin_users":

        users = get_subscribers()

        if not users:

            await query.message.reply_text(
                "👥 قائمة المشتركين\n\n"
                "لا يوجد مشتركون مفعّلون حالياً.",
                reply_markup=admin_menu()
            )

            return

        text = "👥 قائمة المشتركين\n\n"

        for number, (subscriber_id, activated_at) in enumerate(
            users,
            start=1
        ):

            text += (
                f"{number}️⃣ Telegram ID: {subscriber_id}\n"
                f"📅 التفعيل: {activated_at}\n\n"
            )

        text += f"👤 إجمالي المشتركين: {len(users)}"

        await query.message.reply_text(
            text,
            reply_markup=subscribers_menu()
        )

        return

    # =====================================================
    # حذف مشترك يدويًا
    # =====================================================

    if data == "admin_delete":

        await query.message.reply_text(
            "🚫 حذف مشترك\n\n"
            "أرسل Telegram ID الخاص بالمشترك الذي تريد حذفه.\n\n"
            "مثال:\n"
            "123456789"
        )

        return

    # =====================================================
    # إنشاء كود
    # =====================================================

    if data == "admin_newcode":

        code = create_access_code()

        await query.message.reply_text(
            "🎟 تم إنشاء كود جديد\n\n"
            f"🔐 {code}\n\n"
            "♻️ صالح للاستخدام مرة واحدة فقط."
        )

        return

    # =====================================================
    # الإحصائيات
    # =====================================================

    if data == "admin_stats":

        users_count, total, used, unused = get_statistics()

        await query.message.reply_text(
            "📊 إحصائيات بوت الأسد\n\n"
            f"👥 المشتركين: {users_count}\n"
            f"🎟 إجمالي الأكواد: {total}\n"
            f"✅ الأكواد المستخدمة: {used}\n"
            f"🟢 الأكواد المتبقية: {unused}"
        )

        return

    # =====================================================
    # تأكيد الحذف
    # =====================================================

    if data.startswith("confirm_delete:"):

        subscriber_id = int(
            data.split(":")[1]
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "✅ نعم، احذف",
                    callback_data=f"delete_user:{subscriber_id}"
                ),
                InlineKeyboardButton(
                    "❌ إلغاء",
                    callback_data="admin_users"
                )
            ]
        ]

        await query.message.reply_text(
            "⚠️ تأكيد الحذف\n\n"
            f"🆔 Telegram ID:\n{subscriber_id}\n\n"
            "هل تريد حذف هذا المشترك؟\n\n"
            "سيتم إلغاء تفعيله ولن يستطيع استخدام البوت كمشترك.",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

        return

    # =====================================================
    # تنفيذ الحذف
    # =====================================================

    if data.startswith("delete_user:"):

        subscriber_id = int(
            data.split(":")[1]
        )

        deleted = delete_subscriber(subscriber_id)

        if deleted:

            await query.message.reply_text(
                "✅ تم حذف المشترك بنجاح.\n\n"
                f"🆔 Telegram ID: {subscriber_id}",
                reply_markup=admin_menu()
            )

        else:

            await query.message.reply_text(
                "❌ لم يتم العثور على هذا المشترك.",
                reply_markup=admin_menu()
            )

        return

    # =====================================================
    # منع العميل غير المفعل
    # =====================================================

    if not is_admin(user_id) and not is_activated(user_id):

        await query.message.reply_text(
            "🔐 حسابك غير مفعّل.\n"
            "أرسل كود التفعيل أولاً."
        )

        return

    # =====================================================
    # قوائم العميل
    # =====================================================

    if data == "markets":

        await query.message.reply_text(
            "🦁 اختر السوق:",
            reply_markup=main_menu()
        )

    elif data == "new_signal":

        await query.message.reply_text(
            "🦁 اختر السوق:",
            reply_markup=main_menu()
        )

    elif data == "real":

        await query.message.reply_text(
            "📈 اختر زوج العملات:",
            reply_markup=pair_menu(
                REAL_PAIRS,
                "realpair"
            )
        )

    elif data == "otc":

        await query.message.reply_text(
            "🟣 اختر زوج OTC:",
            reply_markup=pair_menu(
                OTC_PAIRS,
                "otcpair"
            )
        )

    elif data.startswith("realpair:"):

        index = int(
            data.split(":")[1]
        )

        if index < 0 or index >= len(REAL_PAIRS):
            return

        await send_signal(
            query,
            REAL_PAIRS[index]
        )

    elif data.startswith("otcpair:"):

        index = int(
            data.split(":")[1]
        )

        if index < 0 or index >= len(OTC_PAIRS):
            return

        await send_signal(
            query,
            OTC_PAIRS[index]
        )

    elif data == "warning":

        await query.message.reply_text(

            "⚠️ تحذير المخاطر\n\n"

            "التداول ينطوي على مخاطر مالية عالية.\n"
            "الإشارات الموجودة في هذا البوت عشوائية وليست توصية استثمارية.\n"
            "استخدم رأس مال تستطيع تحمل خسارته."
        )


# =========================================================
# تشغيل البوت
# =========================================================

def main():

    if not TOKEN:

        raise RuntimeError(
            "TELEGRAM_BOT_TOKEN is not set"
        )

    init_db()

    threading.Thread(
        target=start_health_server,
        daemon=True
    ).start()

    app = (
        Application
        .builder()
        .token(TOKEN)
        .build()
    )

    # /start
    app.add_handler(
        CommandHandler(
            "start",
            start
        )
    )

    # /admin
    app.add_handler(
        CommandHandler(
            "admin",
            admin_command
        )
    )

    # /newcode
    app.add_handler(
        CommandHandler(
            "newcode",
            new_code
        )
    )

    # جميع الرسائل النصية
    # الأدمن: رقم = حذف مشترك
    # العميل: LION-XXXX = تفعيل
    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            text_handler
        )
    )

    # الأزرار
    app.add_handler(
        CallbackQueryHandler(
            button_handler
        )
    )

    print("Bot started")

    app.run_polling()


if __name__ == "__main__":
    main()
