async def text_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.message:
        return

    user_id = update.effective_user.id
    text = update.message.text.strip()

    # =====================================================
    # الأدمن
    # =====================================================

    if is_admin(user_id):

        # إعلان جماعي
        if context.user_data.get("admin_action") == "broadcast":
            context.user_data.pop("admin_action", None)

            users = get_active_users()
            sent = 0
            failed = 0

            for subscriber_id in users:
                try:
                    await update.get_bot().send_message(
                        chat_id=subscriber_id,
                        text=(
                            "📢 <b>إعلان من إدارة بوت الأسد</b>\n\n"
                            + text
                        ),
                        parse_mode="HTML"
                    )
                    sent += 1
                except Exception:
                    failed += 1

            await update.message.reply_text(
                "📢 <b>تم إرسال الإعلان</b>\n\n"
                f"✅ تم الإرسال: {sent}\n"
                f"❌ تعذر الإرسال: {failed}",
                reply_markup=admin_menu(),
                parse_mode="HTML"
            )
            return

        # إذا أرسل الأدمن Telegram ID
        if text.isdigit():
            subscriber_id = int(text)

            if not user_exists(subscriber_id):
                await update.message.reply_text(
                    "❌ هذا الـTelegram ID غير موجود في قاعدة البيانات.",
                    reply_markup=admin_menu()
                )
                return

            conn = db_connect()
            cursor = conn.cursor()
            cursor.execute(
                "SELECT active FROM users WHERE user_id = ?",
                (subscriber_id,)
            )
            row = cursor.fetchone()
            conn.close()

            active = bool(row and row[0] == 1)

            await update.message.reply_text(
                f"👤 <b>بيانات العضو</b>\n\n"
                f"🆔 {subscriber_id}\n"
                f"📌 الحالة: {'🟢 فعال' if active else '🔴 موقوف'}",
                reply_markup=admin_user_actions(
                    subscriber_id,
                    active
                ),
                parse_mode="HTML"
            )
            return

        await update.message.reply_text(
            "👑 استخدم أزرار لوحة الإدارة.",
            reply_markup=admin_menu()
        )
        return

    # =====================================================
    # العميل المفعل
    # =====================================================

    if is_activated(user_id):
        await update.message.reply_text(
            "🦁 حسابك مفعّل بالفعل.\n\n"
            "استخدم الأزرار الموجودة في البوت.",
            reply_markup=main_menu()
        )
        return

    # =====================================================
    # العميل غير المفعل
    # =====================================================

    code = text.upper()

    if not code.startswith("LION-"):
        await update.message.reply_text(
            "🔐 أرسل كود التفعيل بالشكل الصحيح."
        )
        return

    result = activate_code(code, user_id)

    if result == "success":
        await update.message.reply_text(
            "✅ <b>تم تفعيل حسابك بنجاح</b>\n\n"
            "♾️ عضويتك دائمة.\n\n"
            "🦁 أهلاً بك في بوت الأسد.",
            reply_markup=main_menu(),
            parse_mode="HTML"
        )
        return

    if result == "already_active":
        await update.message.reply_text(
            "🟢 حسابك مفعّل بالفعل.",
            reply_markup=main_menu()
        )
        return

    if result == "suspended":
        await update.message.reply_text(
            "🚫 حسابك موقوف حاليًا.\n\n"
            "تواصل مع الدعم إذا كنت تعتقد أن هذا بالخطأ."
        )
        return

    if result == "used":
        await update.message.reply_text(
            "❌ هذا الكود تم استخدامه مسبقًا."
        )
        return

    await update.message.reply_text(
        "❌ كود التفعيل غير صحيح.\n\n"
        "تأكد من الكود وحاول مرة أخرى."
    )


