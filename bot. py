def activate_existing_user(user_id):
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute(
        "UPDATE users SET active = 1 WHERE user_id = ?",
        (user_id,)
    )

    changed = cursor.rowcount > 0

    conn.commit()
    conn.close()

    return changed


def deactivate_user(user_id):
    """
    إيقاف العضو فقط.
    لا نحذف السجل، لذلك يستطيع الأدمن إعادته بدون كود جديد.
    """
    conn = db_connect()
