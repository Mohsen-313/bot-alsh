# =========================================================
# قاعدة البيانات
# =========================================================

def db_connect():
    return sqlite3.connect(DB_FILE)


def init_db():
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            activated_at TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS access_codes (
            code TEXT PRIMARY KEY,
            used_by INTEGER,
            used_at TEXT
        )
    """)

    conn.commit()
    conn.close()


def is_admin(user_id):
    return user_id == ADMIN_ID


def is_activated(user_id):
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute(
        "SELECT user_id FROM users WHERE user_id = ?",
        (user_id,)
    )

    result = cursor.fetchone()

    conn.close()

    return result is not None


def activate_code(code, user_id):
    code = code.strip().upper()

    conn = db_connect()
    cursor = conn.cursor()

    try:
        cursor.execute("BEGIN IMMEDIATE")

        cursor.execute(
            "SELECT used_by FROM access_codes WHERE code = ?",
            (code,)
        )

        result = cursor.fetchone()

        if not result:
            conn.rollback()
            conn.close()
            return False

        if result[0] is not None:
            conn.rollback()
            conn.close()
            return False

        now = datetime.now(timezone.utc).isoformat()

        cursor.execute(
            """
            UPDATE access_codes
            SET used_by = ?, used_at = ?
            WHERE code = ? AND used_by IS NULL
            """,
            (user_id, now, code)
        )

        cursor.execute(
            """
            INSERT OR IGNORE INTO users (user_id, activated_at)
            VALUES (?, ?)
            """,
            (user_id, now)
        )

        conn.commit()
        conn.close()

        return True

    except Exception:
        conn.rollback()
        conn.close()
        return False


def create_access_code():
    while True:

        code = "LION-" + secrets.token_hex(4).upper()

        conn = db_connect()
        cursor = conn.cursor()

        cursor.execute(
            "SELECT code FROM access_codes WHERE code = ?",
            (code,)
        )

        exists = cursor.fetchone()

        if not exists:

            cursor.execute(
                "INSERT INTO access_codes (code) VALUES (?)",
                (code,)
            )

            conn.commit()
            conn.close()

            return code

        conn.close()


# =========================================================
# إحصائيات الإدارة
# =========================================================

def get_statistics():

    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute(
        "SELECT COUNT(*) FROM users"
    )
    users_count = cursor.fetchone()[0]

    cursor.execute(
        "SELECT COUNT(*) FROM access_codes"
    )
    total_codes = cursor.fetchone()[0]

    cursor.execute(
        "SELECT COUNT(*) FROM access_codes WHERE used_by IS NOT NULL"
    )
    used_codes = cursor.fetchone()[0]

    unused_codes = total_codes - used_codes

    conn.close()

    return (
        users_count,
        total_codes,
        used_codes,
        unused_codes
    )


# =========================================================
# Render Health Server
# =========================================================

class HealthHandler(BaseHTTPRequestHandler):

    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Bot is running")

    def log_message(self, format, *args):
        pass


def start_health_server():

    port = int(os.getenv("PORT", "10000"))

    server = HTTPServer(
        ("0.0.0.0", port),
        HealthHandler
    )

    server.serve_forever()


