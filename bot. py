    cursor.execute(
        "UPDATE users SET active = 0 WHERE user_id = ?",
        (user_id,)
    )

    changed = cursor.rowcount > 0

    conn.commit()
    conn.close()

    return changed


def activate_code(code, user_id):
    code = code.strip().upper()

    conn = db_connect()
    cursor = conn.cursor()

    try:
        cursor.execute("BEGIN IMMEDIATE")

        # إذا كان الحساب موجودًا وموقوفًا، لا نستهلك كودًا جديدًا.
        cursor.execute(
            "SELECT active FROM users WHERE user_id = ?",
            (user_id,)
        )
        existing_user = cursor.fetchone()

        if existing_user:
            if existing_user[0] == 1:
                conn.rollback()
                conn.close()
                return "already_active"

            # المستخدم موجود لكنه موقوف.
            # لا نسمح باستخدام كود جديد لتجاوز قرار الإدارة.
            conn.rollback()
            conn.close()
            return "suspended"

        cursor.execute(
            "SELECT used_by FROM access_codes WHERE code = ?",
            (code,)
        )

        result = cursor.fetchone()

        if not result:
            conn.rollback()
            conn.close()
            return "invalid"

        if result[0] is not None:
            conn.rollback()
            conn.close()
            return "used"

        now = utc_now()

        cursor.execute(
            """
            UPDATE access_codes
            SET used_by = ?, used_at = ?
            WHERE code = ? AND used_by IS NULL
            """,
            (user_id, now, code)
        )

        if cursor.rowcount != 1:
            conn.rollback()
            conn.close()
            return "used"

        cursor.execute(
            """
            INSERT INTO users (user_id, activated_at, active)
            VALUES (?, ?, 1)
            """,
            (user_id, now)
        )

        conn.commit()
        conn.close()

        return "success"

    except Exception:
        conn.rollback()
        conn.close()
        return "error"


