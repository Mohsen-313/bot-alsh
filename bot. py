# =========================================================
# استقبال كود العميل
# =========================================================

async def activation_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):

    if not update.message:
        return

    user_id = update.effective_user.id

    # الأدمن لا يحتاج كود
    if is_admin(user_id):
        return

    # المستخدم مفعل مسبقاً
    if is_activated(user_id):
        return

    code = update.message.text.strip().upper()

    if not code.startswith("LION-"):

        await update.message.reply_text(
            "🔐 أرسل كود التفعيل بالشكل الصحيح."
        )

        return

    success = activate_code(code, user_id)

    if not success:

        await update.message.reply_text(
            "❌ كود التفعيل غير صحيح أو تم استخدامه مسبقاً.\n\n"
            "تأكد من الكود وحاول مرة أخرى."
        )

        return

    await update.message.reply_text(
        "✅ تم تفعيل حسابك بنجاح.\n\n"
        "🦁 أهلاً بك في بوت الأسد\n"
        "اختر السوق الذي تريد الدخول إليه:",
        reply_markup=main_menu()
    )


# =========================================================
# إرسال الإشارة
# =========================================================

async def send_signal(query, pair):

    user_id = query.from_user.id

    if not is_admin(user_id) and not is_activated(user_id):

        await query.message.reply_text(
            "🔐 يجب تفعيل حسابك أولاً."
        )

        return

    now = time.time()

    if user_id in last_signal_time:

        elapsed = now - last_signal_time[user_id]

        if elapsed < SIGNAL_COOLDOWN:

            remaining = int(
                SIGNAL_COOLDOWN - elapsed
            )

            await query.message.reply_text(
                f"⏳ انتظر {remaining} ثانية قبل طلب إشارة ثانية."
            )

            return

    last_signal_time[user_id] = now

    direction = random.choice([
        "🟢 BUY",
        "🔴 SELL"
    ])

    duration = random.randint(1, 15)

    keyboard = [
        [
            InlineKeyboardButton(
                "🔄 إشارة ثانية",
                callback_data="new_signal"
            )
        ]
    ]

    await query.message.reply_text(

        "🦁 إشارة الأسد\n\n"

        f"💱 السوق: {pair}\n"

        f"📈 الاتجاه: {direction}\n"

        f"⏱ المدة: {duration} دقيقة\n\n"

        "⚡ يجب عليك الدخول إلى الإشارة فوراً\n\n"

        "⚠️ التداول ينطوي على مخاطر مالية عالية.\n"
        "هذه إشارة عشوائية وليست توصية استثمارية.",

        reply_markup=InlineKeyboardMarkup(keyboard)
    )


# =========================================================
# الأزرار
# =========================================================

async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):

    query = update.callback_query

    await query.answer()

    user_id = query.from_user.id
    data = query.data

    # =====================================================
    # لوحة الإدارة
    # =====================================================

    if data.startswith("admin_"):

        if not is_admin(user_id):

            await query.message.reply_text(
                "⛔ هذا القسم مخصص للإدارة فقط."
            )

            return

        if data == "admin_users":

            users_count, total, used, unused = get_statistics()

            await query.message.reply_text(
                "👥 عدد المشتركين\n\n"
                f"👤 المشتركين المفعّلين: {users_count}"
            )

            return

        if data == "admin_newcode":

            code = create_access_code()

            await query.message.reply_text(
                "🎟 تم إنشاء كود جديد\n\n"
                f"🔐 {code}\n\n"
                "♻️ صالح للاستخدام مرة واحدة فقط."
            )

            return

        if data == "admin_stats":

            users_count, total, used, unused = get_statistics()

            await query.message.reply_text(
                "📊 إحصائيات بوت الأسد\n\n"
                f"👥 المشتركين: {users_count}\n"
                f"🎟 إجمالي الأكواد: {total}\n"
                f"✅ الأكواد المستخدمة: {used}\n"
                f"🟢 الأكواد المتبقية: {unused}"
            )

            return

    # =====================================================
    # منع العميل غير المفعل
    # =====================================================

    if not is_admin(user_id) and not is_activated(user_id):

        await query.message.reply_text(
            "🔐 حسابك غير مفعّل.\n"
            "أرسل كود التفعيل أولاً."
        )

        return

    # =====================================================
    # قوائم العميل
    # =====================================================

    if data == "markets":

        await query.message.reply_text(
            "🦁 اختر السوق:",
            reply_markup=main_menu()
        )

    elif data == "new_signal":

        await query.message.reply_text(
            "🦁 اختر السوق:",
            reply_markup=main_menu()
        )

    elif data == "real":

        await query.message.reply_text(
            "📈 اختر زوج العملات:",
            reply_markup=pair_menu(
                REAL_PAIRS,
                "realpair"
            )
        )

    elif data == "otc":

        await query.message.reply_text(
            "🟣 اختر زوج OTC:",
            reply_markup=pair_menu(
                OTC_PAIRS,
                "otcpair"
            )
        )

    elif data.startswith("realpair:"):

        index = int(
            data.split(":")[1]
        )

        if index < 0 or index >= len(REAL_PAIRS):
            return

        await send_signal(
            query,
            REAL_PAIRS[index]
        )

    elif data.startswith("otcpair:"):

        index = int(
            data.split(":")[1]
        )

        if index < 0 or index >= len(OTC_PAIRS):
            return

        await send_signal(
            query,
            OTC_PAIRS[index]
        )

    elif data == "warning":

        await query.message.reply_text(

            "⚠️ تحذير المخاطر\n\n"

            "التداول ينطوي على مخاطر مالية عالية.\n"
            "الإشارات الموجودة في هذا البوت عشوائية وليست توصية استثمارية.\n"
            "استخدم رأس مال تستطيع تحمل خسارته."
        )


# =========================================================
# تشغيل البوت
# =========================================================

def main():

    if not TOKEN:

        raise RuntimeError(
            "TELEGRAM_BOT_TOKEN is not set"
        )

    init_db()

    threading.Thread(
        target=start_health_server,
        daemon=True
    ).start()

    app = (
        Application
        .builder()
        .token(TOKEN)
        .build()
    )

    # /start
    app.add_handler(
        CommandHandler(
            "start",
            start
        )
    )

    # /admin
    app.add_handler(
        CommandHandler(
            "admin",
            admin_command
        )
    )

    # /newcode
    app.add_handler(
        CommandHandler(
            "newcode",
            new_code
        )
    )

    # أكواد العملاء
    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            activation_handler
        )
    )

    # الأزرار
    app.add_handler(
        CallbackQueryHandler(
            button_handler
        )
    )

    print("Bot started")

    app.run_polling()


if __name__ == "__main__":
    main()
