        remove_favorite(user_id, pair)

        await query.answer(
            "🗑 تمت إزالة الزوج من المفضلة.",
            show_alert=True
        )

        # إعادة فتح القائمة
        favorites = get_favorites(user_id)

        if not favorites:
            await edit_current(
                query,
                "⭐ <b>المفضلة</b>\n\n"
                "لا توجد أزواج محفوظة.",
                InlineKeyboardMarkup([
                    [
                        InlineKeyboardButton(
                            "🏠 الرئيسية",
                            callback_data="home"
                        )
                    ]
                ])
            )
            return

        keyboard = []

        for favorite in favorites:
            keyboard.append([
                InlineKeyboardButton(
                    f"⭐ {favorite}",
                    callback_data=f"favorite_signal:{favorite}"
                ),
                InlineKeyboardButton(
                    "🗑",
                    callback_data=f"fav_remove:{favorite}"
                )
            ])

        keyboard.append([
            InlineKeyboardButton(
                "🏠 الرئيسية",
                callback_data="home"
            )
        ])

        await edit_current(
            query,
            "⭐ <b>المفضلة</b>\n\n"
            "اختر زوجًا للحصول على إشارة:",
            InlineKeyboardMarkup(keyboard)
        )
        return

    # =====================================================
    # إشارة من المفضلة
    # =====================================================

    if data.startswith("favorite_signal:"):
        pair = data.split(":", 1)[1]

        await send_signal(
            query,
            pair
        )
        return

    # =====================================================
    # سجل الإشارات
    # =====================================================

    if data == "history":
        rows = get_history(user_id)

        if not rows:
            await edit_current(
                query,
                "📜 <b>سجل الإشارات</b>\n\n"
                "لا توجد إشارات مسجلة حتى الآن.",
                InlineKeyboardMarkup([
                    [
                        InlineKeyboardButton(
                            "🏠 الرئيسية",
                            callback_data="home"
                        )
                    ]
                ])
            )
            return

        lines = ["📜 <b>آخر الإشارات</b>\n"]

        for pair, direction, duration, created_at in rows:
            short_date = created_at[:19].replace("T", " ")
            lines.append(
                f"• {pair} — {direction} — {duration} د\n"
                f"  🕐 {short_date}"
            )

        await edit_current(
            query,
            "\n".join(lines),
            InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "🏠 الرئيسية",
                        callback_data="home"
                    )
                ]
            ])
        )
        return


# =========================================================
# Health Server
# =========================================================

class HealthHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.end_headers()
        self.wfile.write(b"Bot is running")

    def log_message(self, format, *args):
        pass


def start_health_server():
    port = int(os.getenv("PORT", "10000"))

    server = HTTPServer(
        ("0.0.0.0", port),
        HealthHandler
    )

    server.serve_forever()


# =========================================================
# التشغيل
# =========================================================

def main():
    if not TOKEN:
        raise RuntimeError(
            "TELEGRAM_BOT_TOKEN is not set"
        )

    init_db()

    threading.Thread(
        target=start_health_server,
        daemon=True
    ).start()

    app = (
        Application
        .builder()
        .token(TOKEN)
        .build()
    )

    app.add_handler(
        CommandHandler("start", start)
    )

    app.add_handler(
        CommandHandler("admin", admin_command)
    )

    app.add_handler(
        CommandHandler("newcode", new_code)
    )

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            text_handler
        )
    )

    app.add_handler(
        CallbackQueryHandler(button_handler)
    )

    print("Bot started")
    app.run_polling()


if __name__ == "__main__":
    main()
