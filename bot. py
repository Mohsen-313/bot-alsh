def track_message(user_id, chat_id, message_id):
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute(
        """
        INSERT OR IGNORE INTO user_messages
        (user_id, chat_id, message_id, created_at)
        VALUES (?, ?, ?, ?)
        """,
        (user_id, chat_id, message_id, utc_now())
    )

    # نحافظ فقط على آخر MAX_TRACKED_MESSAGES
    cursor.execute(
        """
        SELECT chat_id, message_id
        FROM user_messages
        WHERE user_id = ?
        ORDER BY created_at DESC
        LIMIT -1 OFFSET ?
        """,
        (user_id, MAX_TRACKED_MESSAGES)
    )

    old = cursor.fetchall()

    if old:
        cursor.executemany(
            """
            DELETE FROM user_messages
            WHERE user_id = ? AND chat_id = ? AND message_id = ?
            """,
            [
                (user_id, chat_id, message_id)
                for chat_id, message_id in old
            ]
        )

    conn.commit()
    conn.close()


def forget_message(user_id, chat_id, message_id):
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute(
        """
        DELETE FROM user_messages
        WHERE user_id = ? AND chat_id = ? AND message_id = ?
        """,
        (user_id, chat_id, message_id)
    )

    conn.commit()
    conn.close()


async def safe_delete_message(bot, user_id, chat_id, message_id):
    try:
        await bot.delete_message(
            chat_id=chat_id,
            message_id=message_id
        )
    except Exception:
        # Telegram قد يمنع حذف بعض الرسائل حسب عمر الرسالة
        # أو صلاحيات Bot API. نتجاهل الخطأ حتى لا يتعطل البوت.
        pass

    forget_message(user_id, chat_id, message_id)


async def cleanup_user_messages(
    bot,
    user_id,
    chat_id,
    keep_message_id=None
):
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT message_id
        FROM user_messages
        WHERE user_id = ? AND chat_id = ?
        """,
        (user_id, chat_id)
    )

    message_ids = [row[0] for row in cursor.fetchall()]
    conn.close()

    for message_id in message_ids:
        if keep_message_id and message_id == keep_message_id:
            continue

        await safe_delete_message(
            bot,
            user_id,
            chat_id,
            message_id
        )


