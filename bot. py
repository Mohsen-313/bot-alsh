async def send_signal(query, pair):
    user_id = query.from_user.id

    if not is_admin(user_id) and not is_activated(user_id):
        await query.answer(
            "🔐 يجب تفعيل حسابك أولاً.",
            show_alert=True
        )
        return

    if maintenance_enabled() and not is_admin(user_id):
        await query.answer(
            "🛠️ البوت في وضع الصيانة حالياً.",
            show_alert=True
        )
        return

    now = time.time()

    if user_id in last_signal_time:
        elapsed = now - last_signal_time[user_id]

        if elapsed < SIGNAL_COOLDOWN:
            remaining = int(SIGNAL_COOLDOWN - elapsed)

            await query.answer(
                f"⏳ انتظر {remaining} ثانية قبل طلب إشارة جديدة.",
                show_alert=True
            )
            return

    last_signal_time[user_id] = now

    # تجهيز بصري صادق: البوت يجهز الإشارة، ولا يدعي وجود تحليل حقيقي.
    loading_messages = [
        "📊 <b>جاري تجهيز الإشارة...</b>\n\n⏳ يرجى الانتظار...",
        "🔄 <b>جاري معالجة الطلب...</b>\n\n⏳ يتم تجهيز الإشارة...",
        "⏳ <b>جارٍ الانتهاء من تجهيز الإشارة...</b>\n\n📡 لحظات فقط..."
    ]

    try:
        await query.edit_message_text(
            loading_messages[0],
            parse_mode="HTML"
        )

        delay = random.uniform(
            MIN_SIGNAL_DELAY,
            MAX_SIGNAL_DELAY
        )

        started = time.monotonic()

        # نغير الرسالة أثناء الانتظار دون تكديس رسائل.
        stages = [
            (0.0, loading_messages[0]),
            (0.35, loading_messages[1]),
            (0.70, loading_messages[2]),
        ]

        for progress, message in stages:
            target = delay * progress
            elapsed = time.monotonic() - started
            wait_for = target - elapsed

            if wait_for > 0:
                await __import__("asyncio").sleep(wait_for)

            try:
                await query.edit_message_text(
                    message,
                    parse_mode="HTML"
                )
            except Exception:
                pass

        remaining = delay - (time.monotonic() - started)

        if remaining > 0:
            await __import__("asyncio").sleep(remaining)

    except Exception:
        pass

    direction = random.choice([
        "🟢 BUY",
        "🔴 SELL"
    ])

    duration = random.randint(1, 15)

    save_signal(
        user_id,
        pair,
        direction,
        duration
    )

    direction_text = "BUY" if "BUY" in direction else "SELL"

    keyboard = [
        [
            InlineKeyboardButton(
                "🔄 إشارة جديدة",
                callback_data="new_signal"
            )
        ],
        [
            InlineKeyboardButton(
                "⭐ إضافة للمفضلة",
                callback_data=f"fav_add:{pair}"
            )
        ],
        [
            InlineKeyboardButton(
                "📢 القناة الأساسية",
                url="https://t.me/gold302r"
            )
        ],
        [
            InlineKeyboardButton(
                "🏠 الرئيسية",
                callback_data="home"
            )
        ]
    ]

    signal_text = (
        "🦁 <b>إشارة الأسد</b>\n\n"
        "━━━━━━━━━━━━━━\n"
        f"💱 <b>السوق:</b> {pair}\n"
        f"📈 <b>الاتجاه:</b> {direction}\n"
        f"⏱ <b>المدة:</b> {duration} دقيقة\n"
        "━━━━━━━━━━━━━━\n\n"
        "⚡ <b>الدخول: فور ظهور الإشارة</b>\n\n"
        "⚠️ <b>تحذير</b>\n"
        "الدخول على مسؤوليتك، والتداول ينطوي على مخاطر مالية.\n"
        "ادخل برأس مال تستطيع تحمّل خسارته."
    )

    try:
        await query.edit_message_text(
            signal_text,
            reply_markup=InlineKeyboardMarkup(keyboard),
            parse_mode="HTML"
        )
    except Exception:
