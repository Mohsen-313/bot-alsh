def get_statistics():
    conn = db_connect()
    cursor = conn.cursor()

    cursor.execute("SELECT COUNT(*) FROM users")
    total_users = cursor.fetchone()[0]

    cursor.execute(
        "SELECT COUNT(*) FROM users WHERE active = 1"
    )
    active_users = cursor.fetchone()[0]

    cursor.execute(
        "SELECT COUNT(*) FROM users WHERE active = 0"
    )
    suspended_users = cursor.fetchone()[0]

    cursor.execute("SELECT COUNT(*) FROM access_codes")
    total_codes = cursor.fetchone()[0]

    cursor.execute(
        "SELECT COUNT(*) FROM access_codes WHERE used_by IS NOT NULL"
    )
    used_codes = cursor.fetchone()[0]

    cursor.execute("SELECT COUNT(*) FROM signal_history")
    signals_count = cursor.fetchone()[0]

    conn.close()

    return (
        total_users,
        active_users,
        suspended_users,
        total_codes,
        used_codes,
        total_codes - used_codes,
        signals_count,
    )


