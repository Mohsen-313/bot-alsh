async def text_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):

    if not update.message:
        return

    user_id = update.effective_user.id
    text = update.message.text.strip()

    # =====================================================
    # الأدمن
    # =====================================================

    if is_admin(user_id):

        # إذا أرسل الأدمن رقم ID
        if text.isdigit():

            subscriber_id = int(text)

            if not is_activated(subscriber_id):

                await update.message.reply_text(
                    "❌ هذا الـTelegram ID غير موجود ضمن المشتركين المفعّلين.",
                    reply_markup=admin_menu()
                )

                return

            keyboard = [
                [
                    InlineKeyboardButton(
                        "✅ نعم، احذف",
                        callback_data=f"delete_user:{subscriber_id}"
                    ),
                    InlineKeyboardButton(
                        "❌ إلغاء",
                        callback_data="admin_back"
                    )
                ]
            ]

            await update.message.reply_text(
                "⚠️ تأكيد الحذف\n\n"
                f"🆔 Telegram ID: {subscriber_id}\n\n"
                "هل أنت متأكد من حذف هذا المشترك؟",
                reply_markup=InlineKeyboardMarkup(keyboard)
            )

            return

        # الأدمن لا يحتاج يرسل أكواد
        await update.message.reply_text(
            "👑 أنت داخل حساب الإدارة.\n\n"
            "استخدم أزرار لوحة الإدارة.",
            reply_markup=admin_menu()
        )

        return

    # =====================================================
    # العميل المفعل
    # =====================================================

    if is_activated(user_id):

        await update.message.reply_text(
            "🦁 حسابك مفعّل بالفعل.\n\n"
            "استخدم الأزرار الموجودة في البوت.",
            reply_markup=main_menu()
        )

        return

    # =====================================================
    # العميل غير المفعل
    # =====================================================

    code = text.upper()

    if not code.startswith("LION-"):

        await update.message.reply_text(
            "🔐 أرسل كود التفعيل بالشكل الصحيح."
        )

        return

    success = activate_code(code, user_id)

    if not success:

        await update.message.reply_text(
            "❌ كود التفعيل غير صحيح أو تم استخدامه مسبقاً.\n\n"
            "تأكد من الكود وحاول مرة أخرى."
        )

        return

    await update.message.reply_text(
        "✅ تم تفعيل حسابك بنجاح.\n\n"
        "🦁 أهلاً بك في بوت الأسد\n"
        "اختر السوق الذي تريد الدخول إليه:",
        reply_markup=main_menu()
    )


